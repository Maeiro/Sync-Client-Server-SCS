{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://github.com/Maeiro/Sync-Client-Server-SCS",
    "issues": "https://github.com/Maeiro/Sync-Client-Server-SCS/issues"
  },
  "license": "${mod_license}",
  "icon": "scs_logo.png",
  "environment": "*",
  "mixins": [
    "scs.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.scs.fabric.SCSFabric"
    ],
    "client": [
      "com.scs.fabric.client.SCSFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*"
  }
}
